{
  "crons": [
    {
      "path": "/api/cron/auto-clockout",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/cycle-rollover",
      "schedule": "0 6 1,16 * *"
    },
    {
      "path": "/api/cron/recap-reminder",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/shift-reminder",
      "schedule": "*/15 * * * *"
    }
  ]
}
